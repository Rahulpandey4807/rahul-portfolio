# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's environment variable settings for
# production. NEVER commit .env.local or real secrets to git.

# Resend API key (https://resend.com) — used to deliver contact form
# submissions. Required.
RESEND_API_KEY= ********

# The email address that receives contact form submissions.
# Defaults to the address in src/data/portfolio-data.ts if unset.
CONTACT_TO_EMAIL=rashupandey2003@gmail.com

# The "from" address Resend sends as. Must be a verified sender/domain in
# your Resend account. The Resend sandbox address below works without
# domain verification for testing.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
